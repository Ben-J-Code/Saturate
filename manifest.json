{
    "manifest_version": 3,
    "name": "Saturate",
    "version": "1.0.0",
    "description": "Give your browser a vibrancy boost with Saturate!\nSaturate individual or all websites.",
    "icons": {
        "48": "icons/saturate_icon_48.png",
        "128": "icons/saturate_icon_128.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "webNavigation",
        "scripting",
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}